{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@chaos_team/blbui-core": ["../../core/src/index.ts"],
            "@chaos_team/blbui-business": ["../../business/src/index.ts"]
        },
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src"]
}
