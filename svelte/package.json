{
  "name": "@chaos_team/blbui-svelte",
  "version": "0.0.2",
  "description": "Svelte 5 bindings for the Chaos industrial admin component library.",
  "homepage": "https://github.com/chao2hang/blbui#readme",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/chao2hang/blbui"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
