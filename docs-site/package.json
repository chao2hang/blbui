{
  "name": "@chaos_team/blbui-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site and interactive playground for BLBUI.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "node_modules/.bin/tsc -p tsconfig.json",
    "lint": "node_modules/.bin/oxlint -c ../../../web/.oxlintrc.json src",
    "format": "node_modules/.bin/oxfmt --write src index.html vite.config.ts",
    "format:check": "node_modules/.bin/oxfmt --check src index.html vite.config.ts",
    "test:smoke": "node_modules/.bin/tsc -p tsconfig.json && node_modules/.bin/vite build"
  },
  "dependencies": {
    "@chaos_team/blbui-business": "workspace:*",
    "@chaos_team/blbui-core": "workspace:*",
    "lit": "^3.3.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "typescript": ">=5.7.0"
  }
}
